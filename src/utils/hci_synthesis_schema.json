{
  "title": "HCI survey synthesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "dek",
    "date",
    "cohort_summary",
    "cohort_grid",
    "task_categories",
    "participants",
    "common_interactions",
    "recovery_strategies",
    "vibe_summary",
    "notes"
  ],
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence",
        "agents",
        "of"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "One observation, one or two sentences."
        },
        "evidence": {
          "type": "string",
          "description": "Report sections that support it, e.g. 'agent_1 4.1; agent_2 3.5'."
        },
        "agents": {
          "type": "integer",
          "minimum": 0,
          "description": "How many of this participant's agents reported it."
        },
        "of": {
          "type": "integer",
          "minimum": 1,
          "description": "How many agent reports this participant has."
        }
      }
    },
    "ranked_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "prevalence",
        "evidence"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Short name, at most 6 words."
        },
        "description": {
          "type": "string",
          "description": "One or two sentences."
        },
        "prevalence": {
          "type": "string",
          "description": "Participants showing it, e.g. '4 of 6 users'."
        },
        "evidence": {
          "type": "string",
          "description": "Participant IDs and report sections."
        }
      }
    }
  },
  "properties": {
    "title": {
      "type": "string"
    },
    "dek": {
      "type": "string",
      "description": "One-sentence summary of the main finding."
    },
    "date": {
      "type": "string",
      "description": "YYYY-MM-DD"
    },
    "cohort_summary": {
      "type": "string",
      "description": "Two to four sentences on how the cohort as a whole works with Claude Code day to day."
    },
    "cohort_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_strength",
        "user_improvement",
        "agent_strength",
        "agent_improvement"
      ],
      "description": "Cohort-level doing well / could improve square: one sentence each, true of most participants.",
      "properties": {
        "user_strength": {
          "type": "string"
        },
        "user_improvement": {
          "type": "string"
        },
        "agent_strength": {
          "type": "string"
        },
        "agent_improvement": {
          "type": "string"
        }
      }
    },
    "task_categories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 7,
      "items": {
        "type": "string"
      },
      "description": "Shared task-type categories (item 3.3) used by every participant's task_mix, at most 6 plus 'Other' last; each at most 4 words."
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "archetype",
          "user_strength",
          "user_improvement",
          "agent_strength",
          "agent_improvement",
          "unique",
          "vibe",
          "task_mix",
          "day_to_day",
          "rituals",
          "handoff"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Participant ID exactly as in qc.csv."
          },
          "archetype": {
            "type": "string",
            "description": "Two-to-five-word workstyle label."
          },
          "user_strength": {
            "$ref": "#/$defs/observation"
          },
          "user_improvement": {
            "$ref": "#/$defs/observation"
          },
          "agent_strength": {
            "$ref": "#/$defs/observation"
          },
          "agent_improvement": {
            "$ref": "#/$defs/observation"
          },
          "unique": {
            "$ref": "#/$defs/observation"
          },
          "task_mix": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "description": "Task-type mix (item 3.3) merged across this participant's agents, using only names from task_categories; largest first; shares sum to 100.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "category",
                "share"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "description": "Exactly one of the names in task_categories."
                },
                "share": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Mean percentage across the participant's agents."
                }
              }
            }
          },
          "day_to_day": {
            "$ref": "#/$defs/observation"
          },
          "rituals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "description": "Recurring workflows and rituals (item 3.5), best supported first.",
            "items": {
              "$ref": "#/$defs/observation"
            }
          },
          "handoff": {
            "type": "string",
            "description": "Exactly two sentences summarising the handoff briefs (item 3.6)."
          },
          "vibe": {
            "type": "array",
            "minItems": 1,
            "description": "One entry per agent report for this participant.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "report",
                "label",
                "rationale"
              ],
              "properties": {
                "report": {
                  "type": "string",
                  "description": "Agent folder name, e.g. 'agent_1'."
                },
                "label": {
                  "type": "string",
                  "enum": [
                    "positive",
                    "neutral",
                    "negative"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "description": "One sentence on what sets the tone."
                }
              }
            }
          }
        }
      }
    },
    "common_interactions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/ranked_item"
      }
    },
    "recovery_strategies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/ranked_item"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Caveats: sample size, evidence gaps, disagreements."
    },
    "vibe_summary": {
      "type": "string",
      "description": "One or two sentences on the overall tone of the reports and what drives it."
    }
  }
}
